---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { PublicShell } from "../components/app/public-shell";
import { listPublicTree } from "../lib/nodes";
import type { ServiceNodeTree } from "../lib/types";

/**
 * Página pública. Sin auth, sin fetch de cliente a /api/nodes — el
 * árbol público se trae en SSR con listPublicTree(), que filtra
 * visibility='public' en el SQL. Un visitante anónimo nunca recibe ni
 * una fila privada en ningún payload de esta página.
 */
let tree: ServiceNodeTree[];
try {
  tree = await listPublicTree();
} catch (err) {
  console.error("[index] fallo al cargar el árbol público:", err);
  tree = [];
}
---

<Layout title="Index" description="Directorio de servicios de iroaK." pwa>
  <PublicShell tree={tree} client:load />
</Layout>

<script>
  if ("serviceWorker" in navigator) {
    void navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
  }
</script>

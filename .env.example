# Postgres — CT110 en producción (10.10.10.232:5432), Postgres local
# (docker-compose.yaml) en desarrollo. CT110 fuerza TLS con certificado
# autofirmado: el DSN debe llevar `sslmode=no-verify` en producción; el
# Postgres local de dev no usa TLS, así que no lleva el parámetro.
INDEX_PAGE_DATABASE_URL=postgresql://index_page:dev_only_password@localhost:55434/index_page

# Cloudflare Access — /app* y /api/* usan el pool compartido "Access 0".
# El AUD es el de esa app; si se recrea el pool, actualizarlo también en Coolify.
CF_ACCESS_TEAM_DOMAIN=iroak.cloudflareaccess.com
CF_ACCESS_AUD=e110c63a32ddddd133bc58747ba9a491c64812195c1694a6addf3a6dcf8a666a

# Allowlist obligatoria de emails autorizados para /app y sus APIs,
# separados por coma. El JWT de Access prueba identidad, no autorización.
# Si falta o queda vacía, el acceso de producción falla cerrado con 503.
INDEX_PAGE_ALLOWED_EMAILS=

# SOLO DESARROLLO LOCAL. Si está definida, verifyAccessRequest() simula
# esta identidad sin necesitar el túnel de Cloudflare — ver
# src/lib/access.ts. NUNCA definir en producción/Coolify: si existe ahí,
# el auth real queda inutilizado.
INDEX_PAGE_DEV_EMAIL=dev@localhost

PORT=4321
HOST=0.0.0.0
